      "width": 1600,
      "height": 20,
      "fontSize": 12,
      "fontFamily": 1,
      "text": "Stack Auth issues the JWT.  Your server NEVER stores passwords.  app_users is only a local mirror keyed by stack_user_id (= JWT 'sub' claim).",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stack Auth issues the JWT.  Your server NEVER stores passwords.  app_users is only a local mirror keyed by stack_user_id (= JWT 'sub' claim).",

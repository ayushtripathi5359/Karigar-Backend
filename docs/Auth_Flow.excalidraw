      "height": 20,
      "fontSize": 12,
      "fontFamily": 1,
      "text": "RED arrows  =  request path (browser \u2192 backend \u2192 response)        GREEN dashed  =  network call to Stack Auth (JWKS / verify)        GRAY arrows  =  in-process function calls",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RED arrows  =  request path (browser \u2192 backend \u2192 response)        GREEN dashed  =  network call to Stack Auth (JWKS / verify)        GRAY arrows  =  in-process function calls",
      "lineHeight": 1.25,
      "baseline": 10
    },

ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/karigar_app

# JWT — generate via: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=change-me-in-production
JWT_ISSUER=karigar
JWT_TOKEN_TTL_DAYS=30

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_CODE_LENGTH=6

# PII encryption + phone hashing
# In production, fetch these from HashiCorp Vault / AWS Secrets Manager.
# Never commit real values.
PII_ENCRYPTION_KEY=dev-encryption-key-change-in-production
PHONE_HASH_PEPPER=dev-phone-pepper-change-in-production
